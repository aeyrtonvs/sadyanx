#!/usr/bin/env python3
"""Entry point. `sadyanx hook guard` is the PreToolUse hook and takes a fast path."""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

if sys.argv[1:3] == ["hook", "guard"]:
    from sadyanxlib.guard import hook_main

    sys.exit(hook_main())

from sadyanxlib.cli import main  # noqa: E402

main()
